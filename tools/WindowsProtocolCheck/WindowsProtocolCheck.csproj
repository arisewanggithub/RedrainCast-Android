<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <WindowsRoot Condition="'$(WindowsRoot)' == ''">$(MSBuildThisFileDirectory)..\..\..\RedrainCast-Windows</WindowsRoot>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(WindowsRoot)\src\ScrcpyReceive.Core\*.cs" Link="WindowsCore\%(Filename)%(Extension)" />
    <Compile Include="$(WindowsRoot)\src\RedrainCast.Protocol\StreamRecovery.cs" Link="WindowsProtocol\StreamRecovery.cs" />
    <Compile Include="$(WindowsRoot)\src\RedrainCast.Protocol\ReceiverOptions.cs" Link="WindowsProtocol\ReceiverOptions.cs" />
    <Compile Include="$(WindowsRoot)\src\RedrainCast.Protocol\MediaTiming.cs" Link="WindowsProtocol\MediaTiming.cs" />
    <Compile Include="$(WindowsRoot)\src\RedrainCast.Protocol\ThreadTiming.cs" Link="WindowsProtocol\ThreadTiming.cs" />
    <EmbeddedResource Include="..\..\protocol\fixtures\opus-pts-order.json" LogicalName="OpusPtsOrderFixture" />
    <EmbeddedResource Include="..\..\protocol\fixtures\receiver-options.json" LogicalName="ReceiverOptionsFixture" />
  </ItemGroup>
</Project>
