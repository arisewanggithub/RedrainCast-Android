    {"json":"{\"receiverOptions\":{\"version\":1,\"supported\":[\"future\",\"playbackStats\"]}}", "enabled":true},
    {"json":"{\"receiverOptions\":{\"version\":2,\"supported\":[\"playbackStats\"]}}", "enabled":false}
