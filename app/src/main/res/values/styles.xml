<resources>
    <style name="Theme.RedrainCast" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/rc_accent</item>
        <item name="android:windowBackground">@color/rc_background</item>
        <item name="android:colorBackground">@color/rc_background</item>
        <item name="android:textColorPrimary">@color/rc_text</item>
        <item name="android:textColorSecondary">@color/rc_text_secondary</item>
        <item name="android:colorControlNormal">@color/rc_text_secondary</item>
        <item name="android:colorControlActivated">@color/rc_accent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:statusBarColor">@color/rc_background</item>
        <item name="android:navigationBarColor">@color/rc_background</item>
        <item name="android:alertDialogTheme">@style/Theme.RedrainCast.Dialog</item>
        <item name="android:buttonStyle">@style/Widget.RedrainCast.Button</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
    <style name="Theme.RedrainCast.Dialog" parent="android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:colorAccent">@color/rc_accent</item>
        <item name="android:colorBackground">@color/rc_surface</item>
        <item name="android:textColorPrimary">@color/rc_text</item>
        <item name="android:textColorSecondary">@color/rc_text_secondary</item>
        <item name="android:colorControlNormal">@color/rc_text_secondary</item>
        <item name="android:colorControlActivated">@color/rc_accent</item>
    </style>
    <style name="Widget.RedrainCast.Button" parent="android:style/Widget.Material.Button">
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/rc_accent</item>
    </style>
</resources>
